# AgentReflex environment configuration.
# Copy to .env and fill in real values. NEVER commit .env.
#
# All variables are AGENT_REFLEX_-prefixed (except the provider-native
# DEEPSEEK_API_KEY / OPENAI_API_KEY fallbacks that resolve_api_key also reads).

# ---------------------------------------------------------------------------
# Runtime environment: development (default) | production
# In production, startup FAILS FAST unless every secret below is set.
# ---------------------------------------------------------------------------
AGENT_REFLEX_ENV=development

# ---------------------------------------------------------------------------
# LLM provider (OpenAI-compatible; DeepSeek by default)
# ---------------------------------------------------------------------------
AGENT_REFLEX_LLM_API_KEY=
# OR the provider-native var (both are honoured):
# DEEPSEEK_API_KEY=
AGENT_REFLEX_LLM_BASE_URL=https://api.deepseek.com
AGENT_REFLEX_LLM_MODEL=deepseek-v4-flash

# ---------------------------------------------------------------------------
# Postgres (same credentials as POSTGRES_USER/POSTGRES_PASSWORD in compose)
# ---------------------------------------------------------------------------
AGENT_REFLEX_DB_URL=postgresql://reflex:change-me@localhost:5432/agent_reflex

# ---------------------------------------------------------------------------
# Neo4j (optional graph store)
# ---------------------------------------------------------------------------
AGENT_REFLEX_NEO4J_URI=bolt://localhost:7687
AGENT_REFLEX_NEO4J_USER=neo4j
AGENT_REFLEX_NEO4J_PASS=change-me

# ---------------------------------------------------------------------------
# OpenTelemetry
# ---------------------------------------------------------------------------
AGENT_REFLEX_OTEL_ENDPOINT=http://localhost:4318

# ---------------------------------------------------------------------------
# API keys used by the collector and Grafana to talk to the AgentReflex API
# (create with: python -m agent_reflex.api.auth create <name> --scope=<read|write>)
# ---------------------------------------------------------------------------
AGENT_REFLEX_API_KEY=

# ---------------------------------------------------------------------------
# docker-compose infrastructure credentials (also parameterised in compose)
# ---------------------------------------------------------------------------
POSTGRES_USER=reflex
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agent_reflex
NEO4J_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me
